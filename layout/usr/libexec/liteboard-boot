#!/bin/sh
# Runs at boot, but only when the jailbreak is active (it lives in /Library/LaunchDaemons).
# SpringBoard on the rootfs is never modified: without the jailbreak this never runs.
[ -e /Library/LiteBoard/disabled ] && exit 0   # set by the watchdog / `liteboardctl disable`

# Never take SpringBoard away unless LiteBoard can actually start from its fixed path.
LB=/Library/LiteBoard/LiteBoard.app/LiteBoard
[ -x "$LB" ] && [ -n "$("$LB" --bundle-id 2>/dev/null)" ] || exit 0

sleep 20   # let stock SpringBoard and the jailbreak settle first
LB_BOOT=1 /usr/bin/liteboardctl enable
